<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.justin06lee.ruri.phone.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ruri</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>ruri scans the pairing code on your Mac, and takes photos you attach to a prompt.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ruri ends quiet hours at Fajr where you are. Only a rough location is used, on this iPhone.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ruri reaches your Mac on your network to show what it's working on.</string>
</dict>
</plist>
