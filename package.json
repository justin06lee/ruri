{
  "name": "ruri",
  "version": "0.57.1",
  "description": "One desktop workspace for all your projects, each a folder of live coding sessions.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "desktop": "bun run build:web && bun run build:main && electron .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build:web": "vite build",
    "build:main": "bun scripts/build-main.ts",
    "build:app": "electron-builder --mac",
    "build": "bun run build:web && bun run build:main && bun run build:app",
    "smoke": "tsx scripts/smoke.ts",
    "bridge-test": "tsx scripts/bridge.ts",
    "rewind-test": "tsx scripts/rewind.ts",
    "checkpoint-test": "tsx scripts/checkpoint.ts",
    "chips-test": "RURI_FIXTURE=1 bun scripts/shot.mjs scripts/chips.mjs",
    "queue-test": "tsx scripts/queue.ts",
    "retry-test": "tsx scripts/retry.ts",
    "recall-test": "tsx scripts/recall.ts",
    "question-test": "tsx scripts/question.ts",
    "naming-test": "tsx scripts/naming.ts",
    "fork-test": "tsx scripts/fork.ts",
    "compaction-attachments-test": "tsx scripts/compaction-attachments.ts",
    "sweep-test": "tsx scripts/sweep.ts",
    "commands-test": "tsx scripts/commands.ts",
    "provider-check": "tsx scripts/provider-check.ts",
    "provider-events": "tsx scripts/provider-events.ts",
    "provider-test": "tsx scripts/provider-session.ts",
    "rewind-compaction-test": "tsx scripts/rewind-compaction.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@justin06lee/yagami": "file:../yagami",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.0",
    "dompurify": "^3.4.14",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "build": {
    "appId": "com.justin06lee.ruri",
    "productName": "ruri",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-web/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
