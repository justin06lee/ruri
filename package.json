{
  "name": "ruri",
  "version": "0.76.0",
  "description": "One desktop workspace for all your projects, each a folder of live coding sessions.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "desktop": "bun run build:web && bun run build:main && electron .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p web/tsconfig.test.json --noEmit",
    "lint": "eslint server shared web/src desktop scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:scripts": "bun scripts/run-tests.ts",
    "build:web": "vite build",
    "build:main": "bun scripts/build-main.ts",
    "build:app": "electron-builder --mac",
    "build": "bun run build:web && bun run build:main && bun run build:app",
    "smoke": "tsx scripts/smoke.ts",
    "auth-test": "tsx scripts/auth.ts",
    "bridge-test": "tsx scripts/bridge.ts",
    "rewind-test": "tsx scripts/rewind.ts",
    "rewind-git-test": "bun scripts/rewind-git.ts",
    "checkpoint-test": "tsx scripts/checkpoint.ts",
    "chips-test": "RURI_FIXTURE=1 bun scripts/shot.mjs scripts/chips.mjs",
    "queue-test": "tsx scripts/queue.ts",
    "terminal-test": "tsx scripts/terminal.ts",
    "meters-test": "tsx scripts/meters.ts",
    "asleep-test": "tsx scripts/asleep.ts",
    "hidden-test": "tsx scripts/hidden.ts",
    "queue-arrange-test": "tsx scripts/queue-arrange.ts",
    "port-test": "tsx scripts/port.ts",
    "md-image-test": "tsx scripts/md-image.ts",
    "retry-test": "tsx scripts/retry.ts",
    "held-queue-test": "tsx scripts/held-queue.ts",
    "recall-test": "tsx scripts/recall.ts",
    "settings-test": "tsx scripts/session-settings.ts",
    "model-switch-test": "tsx scripts/model-switch.ts",
    "question-test": "tsx scripts/question.ts",
    "naming-test": "tsx scripts/naming.ts",
    "fork-test": "tsx scripts/fork.ts",
    "compaction-attachments-test": "tsx scripts/compaction-attachments.ts",
    "sweep-test": "tsx scripts/sweep.ts",
    "uploads-sweep-test": "tsx scripts/uploads-sweep.ts",
    "paragraphs-test": "tsx scripts/paragraphs.ts",
    "idle-reap-test": "tsx scripts/idle-reap.ts",
    "digest-test": "tsx scripts/digest.ts",
    "bridge-close-test": "tsx scripts/bridge-close.ts",
    "history-test": "tsx scripts/history.ts",
    "notes-test": "tsx scripts/notes.ts",
    "orphans-test": "tsx scripts/orphans.ts",
    "home-cap-test": "tsx scripts/home-cap.ts",
    "commands-test": "tsx scripts/commands.ts",
    "provider-check": "tsx scripts/provider-check.ts",
    "provider-events": "tsx scripts/provider-events.ts",
    "subagents-test": "tsx scripts/subagents.ts",
    "subagents-live-test": "tsx scripts/subagents-live.ts",
    "crew-live-test": "tsx scripts/crew-live.ts",
    "provider-test": "tsx scripts/provider-session.ts",
    "rewind-compaction-test": "tsx scripts/rewind-compaction.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@justin06lee/yagami": "^0.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "build": {
    "appId": "com.justin06lee.ruri",
    "productName": "ruri",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-web/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    }
  }
}
